#!/bin/bash
# Development environment management script

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

cd "$PROJECT_ROOT" || exit 1

case "${1:-}" in
    up)
        echo "Starting development environment..."
        docker-compose up -d
        echo ""
        echo "Environment started. Containers:"
        docker-compose ps
        ;;
    down)
        echo "Stopping development environment..."
        docker-compose down
        echo ""
        echo "Environment stopped."
        ;;
    restart)
        echo "Restarting development environment..."
        docker-compose restart
        echo ""
        echo "Environment restarted."
        ;;
    build)
        echo "Building development environment..."
        docker-compose build --no-cache
        echo ""
        echo "Build completed."
        ;;
    rebuild)
        echo "Rebuilding and restarting..."
        docker-compose down
        docker-compose build --no-cache
        docker-compose up -d
        echo ""
        echo "Rebuild completed."
        ;;
    logs)
        echo "Streaming container logs..."
        docker-compose logs -f "$2"
        ;;
    ps)
        echo "Container status:"
        docker-compose ps
        ;;
    shell|sh)
        echo "Opening shell in web container..."
        docker-compose exec web bash
        ;;
    migrate)
        echo "Running database migrations..."
        docker-compose exec web python manage.py migrate
        echo ""
        echo "Migrations completed."
        ;;
    clean)
        echo "WARNING: This will delete all containers, networks, and volumes!"
        read -p "Are you sure? (y/N) " confirm
        if [[ "$confirm" =~ ^[Yy]$ ]]; then
            docker-compose down -v --rmi all --remove-orphans
            echo ""
            echo "Cleanup completed. All data has been deleted!"
        else
            echo "Cleanup cancelled."
        fi
        ;;
    *)
        echo "Usage: $0 {up|down|restart|build|rebuild|logs|ps|shell|migrate|clean}"
        echo ""
        echo "Commands:"
        echo "  up       - Start containers in background"
        echo "  down     - Stop containers"
        echo "  restart  - Restart containers"
        echo "  build    - Build images (no cache)"
        echo "  rebuild  - Stop, build, and start"
        echo "  logs     - Stream logs (optionally specify container)"
        echo "  ps       - Show container status"
        echo "  shell    - Open bash shell in web container"
        echo "  migrate  - Run database migrations"
        echo "  clean    - Remove all containers, networks, and volumes"
        exit 1
        ;;
esac
